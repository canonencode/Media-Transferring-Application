<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <!-- SQLite, not COM: this is a plain managed library with a bundled native
         engine, so it builds and tests under `dotnet` like the rest of this
         project. The COM-free rule below is about the device layer, not about
         dependencies in general. -->
    <PackageReference Include="Microsoft.Data.Sqlite" Version="10.0.0" />
    <!-- Pinned ahead of what Microsoft.Data.Sqlite asks for. Its default pulls
         SQLitePCLRaw 2.1.11, which carries a high-severity advisory
         (GHSA-2m69-gcr7-jv3q) in the bundled native engine. 2.1.13 is the same
         major version - same managed API - with the fixed engine. Left explicit
         so a restore cannot quietly fall back to the vulnerable build. -->
    <PackageReference Include="SQLitePCLRaw.bundle_e_sqlite3" Version="2.1.13" />
  </ItemGroup>

  <!-- This project deliberately has NO COMReference and no dependency on the
       scanner executable. That is not incidental tidiness - it is the thing
       that keeps the claim "this logic is pure" honest:

       1. The .NET Core MSBuild that `dotnet build` and `dotnet test` use has no
          ResolveComReference task (MSB4803), so anything carrying a COM
          reference can only be built by the full Visual Studio MSBuild. Keeping
          this library clear of COM is what lets the tests - and later the UI -
          build and run from the command line at all.

       2. If someone reaches for a WPD type inside FileClassifier or a sink, this
          project stops compiling. The alarm is the build itself, on every run,
          rather than a comment asking people to be careful.

       The scanner executable references this; so do the tests; so will the UI. -->

</Project>
