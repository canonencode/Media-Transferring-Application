<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <!-- Must match the main project, because the files below are compiled with
         these settings there: ImplicitUsings supplies System.IO/System.Collections.Generic
         to FileClassifier.cs, and Nullable is what makes `out string?` and
         `FileKind?` mean what they mean. -->
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <RootNamespace>Device_Probe.Tests</RootNamespace>
  </PropertyGroup>

  <!-- References MediaTransfer.Core, NOT the scanner executable.

       The executable carries COMReference items for PortableDeviceApiLib and
       PortableDeviceTypesLib, and the .NET Core MSBuild behind `dotnet test`
       has no ResolveComReference task (MSB4803) - referencing it would make
       these tests unrunnable from the command line.

       The library has no COM reference of its own, so the old arrangement of
       compiling individual source files in here is no longer needed, and the
       property it was protecting still holds: if COM ever creeps into the
       classes under test, the library stops building and the tests go with it. -->
  <ItemGroup>
    <ProjectReference Include="..\MediaTransfer.Core\MediaTransfer.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.4" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
    <Using Include="MediaTransfer.Core" />
  </ItemGroup>

</Project>
